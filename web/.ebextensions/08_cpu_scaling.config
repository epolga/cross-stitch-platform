Resources:
  AWSEBAutoScalingScaleUpPolicyCPU:
    Type: AWS::AutoScaling::ScalingPolicy
    Properties:
      ScalingAdjustment: "1"
      AutoScalingGroupName:
        Ref: AWSEBAutoScalingGroup
      AdjustmentType: ChangeInCapacity
      Cooldown: "360"

  AWSEBCloudwatchAlarmHighCPU:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions:
        - Ref: AWSEBAutoScalingScaleUpPolicyCPU
      MetricName: CPUUtilization
      ComparisonOperator: GreaterThanThreshold
      Statistic: Maximum
      AlarmDescription: "Scale up when any single instance's CPU exceeds threshold - added alongside the existing NetworkOut trigger because CPU-bound load (photo-converter pattern generation) doesn't move NetworkOut enough to trigger it. Statistic is Maximum, not Average: tested 2026-09-01 with one of two instances stress-loaded to ~100% - the ASG-aggregate Average statistic diluted to ~51% (would have missed a 65% threshold), while Maximum correctly read ~100%, matching the single overloaded instance regardless of how many other instances are idle. See docs/web/photo-converter-cpu-saturation-2026-09.md."
      Period: "300"
      Dimensions:
        - Name: AutoScalingGroupName
          Value:
            Ref: AWSEBAutoScalingGroup
      EvaluationPeriods: "1"
      Namespace: AWS/EC2
      Threshold: "65"
