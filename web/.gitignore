# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.env
.env.local
.env.development
.env.production
.DS_Store

# testing
/coverage

# next.js
/.next/
/out/

# webstorm
/.idea/

# vs code
/.vs/

# production
/build

# misc
.DS_Store
*.pem
.tmp/
.lighthouse/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# automation secrets & generated reports
automation/pinterest-agent/.env
automation/pinterest-agent/pinterest_tokens.json
automation/pinterest-agent/google-oauth-client.json
automation/pinterest-agent/reports/
automation/pinterest-agent/daily-run.log

# Claude Code local settings (per-user permissions, never committed)
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock

# Babysitter local working state (SDK install, run journal, drafts, blobs)
.a5c/
.a5c_backup/
