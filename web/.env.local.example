# ─── AWS / DynamoDB ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=CrossStitchItems
DDB_USERS_TABLE=CrossStitchUsers
DDB_RESET_TOKENS_TABLE=PasswordResetTokens
DDB_SEARCH_QUERIES_TABLE=SearchQueries

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cross-stitch.com
NEXT_PUBLIC_DOWNLOAD_MODE=paid   # 'free' | 'register' | 'paid'

# ─── PayPal ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=https://api-m.paypal.com

# ─── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=cross-stitch-sitemap-cache

# ─── AdSense ad slots ─────────────────────────────────────────────────────────
NEXT_PUBLIC_AD_SLOT_DESIGN_TOP=
NEXT_PUBLIC_AD_SLOT_DESIGN_BOTTOM=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Affiliate links ──────────────────────────────────────────────────────────
# Obtain real IDs from each affiliate programme before filling these in.
# Leave blank (or omit) to hide that store's links entirely.
# LoveCrafts affiliate URL — include your tracking tag in the URL, e.g.:
#   https://www.lovecrafts.com/en-gb/l/needle-crafts/cross-stitch?utm_source=...
NEXT_PUBLIC_LOVECRAFTS_AFFILIATE_URL=
# Amazon affiliate URL — include your Associates tag as a query param, e.g.:
#   https://www.amazon.com/s?k=cross+stitch+supplies&tag=YOUR-TAG-20
NEXT_PUBLIC_AMAZON_AFFILIATE_URL=
